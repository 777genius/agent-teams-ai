  "commonReceiptSourceAndCleanupVerifierExcerpt": [
    "const lane = process.env.HOST_EMULATED_LANE;",
    "const routes = {",
    "  'opencode-v2-review': ['native-review-ui', 'native-review-readback-ui'],",
    "  'opencode-v2-quit-active': ['native-quit-ui', 'native-quit-readback-ui'],",
    "  'opencode-v2-quit-pending-open': ['native-quit-ui', 'native-quit-readback-ui'],",
    "  'opencode-v2-resume': ['native-resume-ui', ''],",
    "  'opencode-v2-chat-attachments': ['native-conversation-ui', 'native-readback-ui'],",
    "};",
    "assert.ok(Object.hasOwn(routes, lane), 'one closed original V2 journey');",
    "const [mode, coldMode] = routes[lane];",
    "assert.equal(process.env.HOST_EMULATED_V2_MODE, mode);",
    "assert.equal(process.env.HOST_EMULATED_V2_READBACK_MODE ?? '', coldMode);",
    "const inputs = JSON.parse(readFileSync(join(process.env.RUNNER_TEMP, 'host-emulated-inputs.json'), 'utf8'));",
    "const native = JSON.parse(readFileSync(join(process.env.RUNNER_TEMP, 'host-emulated-opencode-v2-inputs.json'), 'utf8'));",
    "assert.equal(inputs.sourceHead, process.env.HOST_EMULATED_SOURCE_HEAD);",
    "assert.equal(execFileSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8' }).trim(), inputs.sourceHead);",
    "assert.equal(execFileSync('git', ['status', '--porcelain', '--untracked-files=no'], { encoding: 'utf8' }).trim(), '');",
    "assert.equal(process.platform, 'darwin'); assert.equal(process.arch, 'arm64'); assert.equal(process.version, 'v24.21.0');",
    "assert.equal(inputs.platform + '-' + inputs.architecture, 'darwin-arm64');",
    "assert.equal(inputs.nativeProviders, 'OpenCode V2 with finite localhost model only');",
    "assert.equal(native.sourceHead, inputs.sourceHead); assert.equal(native.platform, 'darwin-arm64'); assert.equal(native.status, 'READY');",
    "const currentSources = await captureDesktopSourceHashes(process.cwd(), desktopProofSources);",
    "assert.equal(new Set(desktopProofSources).size, desktopProofSources.length);",
    "function read(mode, filename, log) {",
    "  const prepared = readFileSync(join(process.env.RUNNER_TEMP, log), 'utf8').split('\\n')",
    "    .flatMap(line => { try { const row = JSON.parse(line); return row.phase === 'prepared' ? [row] : []; } catch { return []; } });",
    "  assert.equal(prepared.length, 1, 'one original prepared epoch, no automatic retry');",
    "  const path = realpathSync(prepared[0].receipt), root = dirname(path);",
    "  assert.equal(path, prepared[0].receipt); assert.equal(basename(path), filename);",
    "  assert.equal(dirname(root), realpathSync(process.env.RUNNER_TEMP));",
    "  assert.match(basename(root), /^TEST-desktop-backend-[A-Za-z0-9]+$/);",
    "  const receipt = JSON.parse(readFileSync(path, 'utf8'));",
    "  assert.equal(receipt.root, root); assert.equal(receipt.mode, mode); assert.equal(receipt.status, 'PASS');",
    "  return { path, root, receipt, sha256: sha(path) };",
    "}",
    "const warm = read(mode, 'desktop-backend-receipt.json', `host-emulated-${lane}-ui.log`);",
    "const cold = coldMode ? read(coldMode, mode === 'native-review-ui' ? 'desktop-native-review-readback-receipt.json'",
    "  : 'desktop-readback-receipt.json', `host-emulated-${lane}-readback-ui.log`) : undefined;",
    "if (cold) {",
    "  assert.equal(cold.root, warm.root); assert.equal(cold.root, process.env.LEGACY_DESKTOP_READBACK_ROOT);",
    "  assert.equal(warm.sha256, process.env.LEGACY_DESKTOP_READBACK_RECEIPT_SHA256);",
    "}",
    "const epochs = cold ? [warm, cold] : [warm];",
    "for (const { root, receipt } of epochs) {",
    "  for (const key of ['failure', 'sourceFreezeFailure', 'nativeInputFreezeFailure', 'sentinelCensusFailure', 'logCleanupFailure', 'metadataObservationFailure'])",
    "    assert.equal(receipt[key], undefined, key);",
    "  assert.equal(receipt.quitRequested, true);",
    "  assert.deepEqual(receipt.selectedSourceHashesBeforeApp, currentSources);",
    "  assert.deepEqual(receipt.selectedSourceHashesAfterFlow, receipt.selectedSourceHashesBeforeApp);",
    "  // These original arrays are Codex-specific, not a V2 final Bun/graph rehash.",
    "  assert.deepEqual(receipt.selectedNativeInputHashesBeforeApp ?? [], []);",
    "  assert.deepEqual(receipt.selectedNativeInputHashesAfterCleanup ?? [], []);",
    "  const cleanup = receipt.cleanup;",
    "  assert.equal(cleanup.appExitCode, 0); assert.equal(cleanup.appSignalCode, null);",
    "  assert.equal(cleanup.capturedHostObserved, true); assert.equal(cleanup.capturedHostAbsent, true);",
    "  assert.deepEqual(cleanup.remaining, []); assert.equal(cleanup.cleanupFailure, undefined);",
    "  assert.equal(receipt.hostChild.observedBeforeShutdown, true);",
    "  for (const [pathKey, pinKey, inputKey] of [",
    "    ['node', 'nodeSha256', 'LEGACY_DESKTOP_NODE_SHA256'],",
    "    ['hostEntry', 'hostEntrySha256', 'LEGACY_DESKTOP_HOST_ENTRY_SHA256'],",
    "    ['pnpm', 'pnpmSha256', 'LEGACY_DESKTOP_PNPM_SHA256'],",
    "  ]) { assert.equal(receipt.pins[pinKey], inputs.values[inputKey]); assert.equal(sha(receipt.paths[pathKey]), receipt.pins[pinKey]); }",
    "  assert.equal(receipt.paths.node, realpathSync(process.execPath));",
    "  assert.equal(receipt.paths.hostEntry, realpathSync('packages/legacy-agent-host/dist/cli.js'));",
    "  assert.equal(receipt.paths.pnpm, realpathSync(inputs.values.LEGACY_DESKTOP_PNPM_PATH));",
    "  for (const [pathKey, pinKey, filename] of [['profile', 'profileSha256', 'host-profile.json'], ['descriptor', 'descriptorSha256', 'desktop-descriptor.json']]) {",
    "    assert.equal(receipt.paths[pathKey], join(root, filename)); assert.equal(sha(receipt.paths[pathKey]), receipt.pins[pinKey]);",
    "  }",
    "  for (const [pathKey, pinKey, inputKey] of [",
    "    ['packagePath', 'corepackPackageSha256', 'LEGACY_DESKTOP_COREPACK_PACKAGE_SHA256'],",
    "    ['libraryPath', 'corepackLibrarySha256', 'LEGACY_DESKTOP_COREPACK_LIBRARY_SHA256'],",
    "  ]) { assert.equal(receipt.pins[pinKey], inputs.values[inputKey]); assert.equal(sha(receipt.packageManager[pathKey]), receipt.pins[pinKey]); }",
    "  const census = receipt.finalSentinelCensus;",
    "  assert.ok(receipt.sentinel.length > 0 && receipt.sentinel.every(row => row.allowed === true));",
    "  assert.equal(census.preQuitCount, receipt.sentinel.length);",
    "  assert.deepEqual(census.invocations.slice(0, census.preQuitCount), receipt.sentinel);",
    "  assert.deepEqual(census.refusedInvocations, census.invocations.filter(row => row.allowed !== true));",
    "}",
    "// The warm step checked its own compiled epoch; do not compare two builds to each other.",
    "if (cold) assert.deepEqual(cold.receipt.compiledBundleHashesAfterStartup, await compiledBundleHashes(join(process.cwd(), 'dist-electron')));",
    "const screenshots = [], metadataOwners = [];",
    "assert.equal(warm.receipt.nativeProvider, 'opencode'); assert.equal(warm.receipt.nativeGeneration, 'v2');"
  ],
  "selectedVerifierBranch": [
    "  assert.equal(mode, 'native-conversation-ui');",
    "  const conversation = warm.receipt.conversationUiProof, attachments = warm.receipt.nativeChatAttachments;",
    "  const readback = cold.receipt.savedNativeReadback, savedAttachments = cold.receipt.nativeChatAttachments;",
    "  assert.equal(conversation.status, 'PASS'); assert.equal(conversation.nativeGeneration, 'v2'); assert.equal(conversation.nativeInputs, 2);",
    "  assert.equal(conversation.incomingIds.length, 2); assert.equal(new Set(conversation.incomingIds).size, 2);",
    "  assert.equal(conversation.custody, 'released'); assert.equal(conversation.nativeChildAbsentBeforeQuit, true);",
    "  assert.equal(attachments.status, 'PASS'); assert.equal(attachments.files.length, 1);",
    "  assert.equal(attachments.files[0].mimeType, 'image/png'); assert.equal(attachments.preparedImage.mimeType, 'image/png');",
    "  assert.equal(attachments.preparedImage.originalFilename, attachments.files[0].filename);",
    "  assert.equal(attachments.preparedImage.width, 2); assert.equal(attachments.preparedImage.height, 1);",
    "  assert.deepEqual(attachments.preview, { sha256: attachments.preparedImage.sha256, width: 2, height: 1 });",
    "  for (const file of [attachments.files[0], attachments.preparedImage]) {",
    "    assert.equal(basename(file.filename), file.filename);",
    "    const path = join(warm.root, 'native-chat-attachment-inputs', file.filename), bytes = readFileSync(path);",
    "    assert.equal(realpathSync(path), path); assert.equal(bytes.length, file.size); assert.equal(sha(path), file.sha256);",
    "    assert.equal(bytes.subarray(0, 8).toString('hex'), '89504e470d0a1a0a');",
    "  }",
    "  assert.equal(attachments.sentMessage.messageId, conversation.incomingIds[1]); assert.equal(attachments.sentMessage.expanded, true);",
    "  assert.equal(attachments.sentMessage.attachments.length, 1);",
    "  const sent = attachments.sentMessage.attachments[0];",
    "  assert.equal(sent.filename, attachments.files[0].filename); assert.equal(sent.mimeType, 'image/png'); assert.equal(sent.size, attachments.preparedImage.size);",
    "  assert.match(attachments.nativeHistory.sha256, /^[a-f0-9]{64}$/);",
    "  const images = warm.receipt.model.observations.filter(row => row.turn === 'OPENCODE_TEAM_TWO');",
    "  assert.equal(images.length, 3); assert.ok(images.every(row => row.nativeImage?.nativeSha256 === attachments.preparedImage.sha256));",
    "  assert.deepEqual(warm.receipt.model.failures, []);",
    "  assert.equal(readback.status, 'PASS'); assert.equal(readback.nativeInputsReplayed, 0); assert.equal(readback.nativeAllocations, 0);",
    "  assert.equal(readback.metadataProcessCount, 1); assert.equal(readback.runtimeRecordUnchanged, true);",
    "  assert.equal(readback.runtimeAllocationScope, 'Runtime session children; the original read-only metadata child is counted separately');",
    "  assert.equal(savedAttachments.status, 'PASS');",
    "  for (const key of ['files', 'preparedImage', 'preview', 'sentMessage', 'nativeHistory']) assert.deepEqual(savedAttachments[key], attachments[key]);",
    "  const setup = warm.receipt.nativeSetup;",
    "  assert.equal(setup.status, 'ready');",
    "  metadataOwners.push([setup, setup.metadataAtRuntimeObservation, setup.metadataAbsentBeforeHarnessCleanup]);",
    "  screenshots.push([warm.receipt.conversationScreenshot, 'ui-native-replies.png'], [readback.screenshot, 'ui-native-readback.png']);",
    "}"
  ],
