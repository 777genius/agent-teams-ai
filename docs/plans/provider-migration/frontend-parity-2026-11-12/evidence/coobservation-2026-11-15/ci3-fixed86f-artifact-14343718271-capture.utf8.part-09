      "crcVerified": true,
      "encoding": "utf-8",
      "body": "[\n  {\n    \"from\": \"user\",\n    \"to\": \"alice\",\n    \"text\": \"**start working on task now** #120cdc0a \\\"TEST ordinary dependent board task\\\"\\n\\nDetails:\\nTEST ordinary dependent board task\\n\\n<info_for_agent>\\nThis start notification can become stale after reassignment or completion. Before modifying anything, fetch the current task and verify that task.owner is your configured teammate name and task.status is pending or in_progress. If the owner changed or the task is completed/deleted, do not start or reopen it, modify files, add a completion comment, or complete it; stop unless the current owner explicitly asks you to collaborate on fresh follow-up work.\\nBegin work on this task immediately. Keep it moving until it is completed or clearly blocked. Do not leave it idle.\\nTo fetch the full task context (description, comments, attachments) use:\\ntask_get { taskId: \\\"120cdc0a-fa21-523c-85ca-1656de5ed0b6\\\" }\\nWhen done, update task status:\\ntask_complete { taskId: \\\"120cdc0a-fa21-523c-85ca-1656de5ed0b6\\\", commandId: \\\"<new stable completion command ID>\\\" }\\n</info_for_agent>\",\n    \"timestamp\": \"2026-11-17T15:41:15.144Z\",\n    \"read\": false,\n    \"summary\": \"Start working on #120cdc0a\",\n    \"source\": \"system_notification\",\n    \"messageId\": \"34f6b70f-419a-56dc-94bd-4e9f2584bfb1\"\n  },\n  {\n    \"from\": \"user\",\n    \"to\": \"alice\",\n    \"text\": \"**Comment on task #120cdc0a** _TEST ordinary dependent board task_\\n\\n> TEST attachment comment original\\n\\n<info_for_agent>\\nReply to this comment using MCP tool task_add_comment:\\n{ teamName: \\\"test-desktop-backend\\\", taskId: \\\"120cdc0a-fa21-523c-85ca-1656de5ed0b6\\\", text: \\\"<your reply>\\\", from: \\\"<your-name>\\\" }\\n</info_for_agent>\",\n    \"timestamp\": \"2026-11-17T15:41:40.683Z\",\n    \"read\": false,\n    \"summary\": \"Comment on #120cdc0a\",\n    \"source\": \"system_notification\",\n    \"messageId\": \"3385ed1e-edf5-4f13-b716-03f8afb9cdf7\"\n  },\n  {\n    \"from\": \"user\",\n    \"to\": \"alice\",\n    \"text\": \"@user **requested changes** for task #120cdc0a\\n\\nTEST fix the review edge case\\n\\nThe task has been moved back to pending. When you are ready to resume, review the task context, start it explicitly, implement the fixes, mark it completed, and request review again.\",\n    \"timestamp\": \"2026-11-17T15:42:15.716Z\",\n    \"read\": false,\n    \"summary\": \"Fix request for #120cdc0a\",\n    \"source\": \"system_notification\",\n    \"messageId\": \"d4b5f205-5f48-4028-818e-d47a16debfe4\"\n  },\n  {\n    \"from\": \"user\",\n    \"to\": \"alice\",\n    \"text\": \"**start working on task now** #120cdc0a \\\"TEST ordinary dependent board task\\\"\\n\\nDetails:\\nTEST ordinary dependent board task\\n\\n<info_for_agent>\\nThis start notification can become stale after reassignment or completion. Before modifying anything, fetch the current task and verify that task.owner is your configured teammate name and task.status is pending or in_progress. If the owner changed or the task is completed/deleted, do not start or reopen it, modify files, add a completion comment, or complete it; stop unless the current owner explicitly asks you to collaborate on fresh follow-up work.\\nBegin work on this task immediately. Keep it moving until it is completed or clearly blocked. Do not leave it idle.\\nTo fetch the full task context (description, comments, attachments) use:\\ntask_get { taskId: \\\"120cdc0a-fa21-523c-85ca-1656de5ed0b6\\\" }\\nWhen done, update task status:\\ntask_complete { taskId: \\\"120cdc0a-fa21-523c-85ca-1656de5ed0b6\\\", commandId: \\\"<new stable completion command ID>\\\" }\\n</info_for_agent>\",\n    \"timestamp\": \"2026-11-17T15:42:17.759Z\",\n    \"read\": false,\n    \"summary\": \"Start working on #120cdc0a\",\n    \"source\": \"system_notification\",\n    \"messageId\": \"59c308a7-a149-516c-bbfe-266ba3252206\"\n  },\n  {\n    \"from\": \"user\",\n    \"to\": \"alice\",\n    \"text\": \"**Comment on task #120cdc0a** _TEST ordinary dependent board task_\\n\\n> TEST review correction addressed in this product-only task cycle\\n\\n<info_for_agent>\\nReply to this comment using MCP tool task_add_comment:\\n{ teamName: \\\"test-desktop-backend\\\", taskId: \\\"120cdc0a-fa21-523c-85ca-1656de5ed0b6\\\", text: \\\"<your reply>\\\", from: \\\"<your-name>\\\" }\\n</info_for_agent>\",\n    \"timestamp\": \"2026-11-17T15:42:23.832Z\",\n    \"read\": false,\n    \"summary\": \"Comment on #120cdc0a\",\n    \"source\": \"system_notification\",\n    \"messageId\": \"cee1d904-fe34-476f-a415-89e265d3ee0c\"\n  },\n  {\n    \"from\": \"user\",\n    \"to\": \"alice\",\n    \"text\": \"@user **approved** task #120cdc0a\",\n    \"timestamp\": \"2026-11-17T15:42:31.584Z\",\n    \"read\": false,\n    \"summary\": \"Approved #120cdc0a\",\n    \"source\": \"system_notification\",\n    \"messageId\": \"eec51624-185e-4436-96c9-7dc8ea0a0a1e\"\n  }\n]"
