eforeSourceOverlay']\n+        assert historical_cfg['sourceOverlay'] == cfg['sourceOverlay']\n+        assert historical['writtenPaths'] == written_paths\n+        for historical_role, historical_pin in [\n+            ('historicalTestMaterializationRootActual', historical['acceptedPublication']['root']),\n+            ('historicalTestMaterializationIndependentActual', historical['acceptedPublication']['independent']),\n+        ]:\n+            historical_reviews = [row for row in cfg['acceptedReviewBodies'] if row['role'] == historical_role]\n+            assert len(historical_reviews) == 1 and historical_reviews[0]['identity'] == historical_pin\n+        historical_outer_body = cfg['historicalEvidenceBodies']['testMaterializationOuter']\n+        assert historical_outer_body['identity'] == historical['observedOuter']\n+        assert identity(historical_outer_body['body'].encode()) == historical['observedOuter']\n+        historical_outer = json.loads(historical_outer_body['body'])\n+        assert historical_outer['observedOuterExit'] == historical_outer['finalToolResult']['exit_code'] == 0\n+        assert historical_outer['selectedAttemptSpent'] is True and historical_outer['replayed'] is False\n+        assert historical_outer['runtimeTestPackageExecuted'] is False\n+        historical_refused_body = cfg['historicalEvidenceBodies']['refusedCombinedOuter']\n+        assert historical_refused_body['identity'] == combined_r1['supersedes']['originalRefusedAttempt']['outer']\n+        assert identity(historical_refused_body['body'].encode()) == historical_refused_body['identity']\n+        historical_refused = json.loads(historical_refused_body['body'])\n+        assert historical_refused['observedOuterExit'] == historical_refused['finalToolResult']['exit_code'] == 2\n+        assert historical_refused['attemptSpent'] is True and historical_refused['replayed'] is False\n+        materialized_path = pathlib.Path(historical['receiptPath'])\n+    else:\n+        materialized_path = OUTROOT / 'materialize-producers' / 'phase-receipt.json'\n     assert materialized_path.is_file() and not materialized_path.is_symlink()\n     materialized_bytes = materialized_path.read_bytes()\n     control_pins.append((materialized_path, identity(materialized_bytes)))\n     materialized = json.loads(materialized_bytes)\n     assert materialized['action'] == 'materialize' and materialized['command'] == phase\n-    assert materialized['bindingIdentity'] == identity(binding_bytes)\n+    if phase == 'red':\n+        assert identity(materialized_bytes) == historical['receipt']\n+        assert materialized['bindingIdentity'] == historical['originalBinding']['identity']\n+        assert materialized['runnerIdentity'] == historical['originalRunner']['identity']\n+        assert materialized['publishedR1'] == historical['originalR1']['publication']\n+        assert materialized['sourcePins'] == cfg['sourcePins']\n+        assert {key: materialized['before']['source'][key] for key in ['bytes', 'sha256', 'gitBlob']} == historical['sourceBefore']\n+        assert {key: materialized['after']['source'][key] for key in ['bytes', 'sha256', 'gitBlob']} == historical['sourceAfter']\n+        assert materialized['commandCompletedNormally'] is False and materialized['semanticAdmissionComplete'] is False\n+    else:\n+        assert materialized['bindingIdentity'] == identity(binding_bytes)\n     assert materialized['publishedSubject'] == cfg['publishedSubject']\n     assert materialized['testIdentities'] == TEST_IDENTITIES\n     assert materialized['sourceVectorIdentity'] == cfg['sourceVectorIdentity']\n",
