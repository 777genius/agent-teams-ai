        "import assert from 'node:assert/strict';\nimport {existsSync,readFileSync} from 'node:fs';\nimport {createHash} from 'node:crypto';\nimport {desktopProofSources} from './scripts/legacy-agent-host/desktop-proof-sources.ts';\nimport {desktopProofWindowsRetrySources} from './scripts/legacy-agent-host/desktop-proof-supplementary-sources.ts';\nconst file='scripts/legacy-agent-host/desktop-packaged-relaunch-smoke.ts',source=readFileSync(file,'utf8');\nconst blocks=[...source.matchAll(/const sources = \\[\\.\\.\\.new Set\\(\\[\\.\\.\\.desktopProofSources,([\\s\\S]*?)\\]\\)\\];/g)];\nassert.equal(blocks.length,1);\nconst extras=[...blocks[0][1].matchAll(/'([^']+)'/g)].map(m=>m[1]);\nassert.deepEqual(extras,[file,'packages/legacy-agent-host/tests/opencode-v1-version-source.ts','scripts/e2e/comment-notification/cdp.mjs']);\nconst common=[...new Set(desktopProofSources)].sort(),windows=[...new Set([...common,...desktopProofWindowsRetrySources])].sort(),packaged=[...new Set([...common,...extras])].sort();\nconst rows=[['common',common,1757,'2e4566fa4aafd7b6db99195177385ffa96c2b1e50b72f260dd13fb61181473eb'],['windows',windows,1798,'2c8ba366802fe193a354ec13a4ec39b2231e6bfccbd3462f6fec0b60797dc9f6'],['packaged',packaged,1760,'c33360dbea805e11577d133b488682a9f3b7de83686801ab656eafcec1b94625']];\nfor(const[name,paths,count,digest]of rows){const raw=JSON.stringify(paths)+'\\n',actual=createHash('sha256').update(raw).digest('hex');assert.equal(paths.length,count);assert.equal(actual,digest);for(const p of paths)assert.ok(existsSync(p),p);console.log(JSON.stringify({name,count,bytes:Buffer.byteLength(raw),sha256:actual,allPathsExist:true}));}\n"
