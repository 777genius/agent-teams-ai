+async function passiveTeamNavigationFixture() {
+  const a = 'host-team:TEST-desktop-handle-TEST-observer';
+  const b = 'host-team:110ff390-0cbc-5ed7-936b-804bb4555b6b';
+  const state: Record<string, unknown> = { selectedTeamName: a };
+  const counts = { state: 0, clock: 0, guard: 0, step: 0, target: 0, attribute: 0 };
+  const fault = { state: false, target: false, attribute: false };
+  const input = { teamKey: b as unknown, hasCard: true };
+  const refusal = new Error('TEST passive observation failure');
+  const getState = () => { counts.state++; if (fault.state) throw refusal; return state; };
+  const store: Record<string, unknown> = { getState };
+  const window: Record<string, unknown> = { __agentTeamsDevStore: store };
+  const microtasks: (() => void)[] = [], timeouts: (() => void)[] = [];
+  const listeners = new Map<string, (event: Record<string, unknown>) => void>();
+  const registrations: { type: string; options: unknown }[] = [];
+  const expressions: string[] = [], sends: { method: string; params: unknown }[] = [];
+  class ObservedElement {
+    tagName = 'DIV'; id = ''; className = 'TEST-original-card-child';
+    closest(selector: string): ObservedElement | null {
+      if (selector !== '[data-team-name]') return null;
+      counts.target++; if (fault.target) throw refusal;
+      return input.hasCard ? card : null;
+    }
+    getAttribute(name: string) {
+      if (name !== 'data-team-name') return null;
+      counts.attribute++; if (fault.attribute) throw refusal;
+      return input.teamKey;
+    }
+  }
+  const card = new ObservedElement(), child = new ObservedElement();
+  const ui = createDesktopUiControls({
+    async send(method, params) { sends.push({ method, params }); return {}; },
+    async evaluate(expression) {
+      expressions.push(expression);
+      if (expression === 'document.visibilityState') return 'visible';
+      return runInNewContext(expression, {
+        window, Element: ObservedElement, HTMLButtonElement: ObservedElement,
+        performance: { now() { counts.clock++; return 123; } },
+        document: {
+          activeElement: null, querySelectorAll() { return []; },
+          addEventListener(type: string, listener: (event: Record<string, unknown>) => void, options: unknown) {
+            assert.equal(listeners.has(type), false); listeners.set(type, listener);
+            registrations.push({ type, options: JSON.parse(JSON.stringify(options)) });
+          },
+        },
+        queueMicrotask(callback: () => void) { microtasks.push(callback); },
+        setTimeout(callback: () => void, delay: number) { assert.equal(delay, 0); timeouts.push(callback); return 1; },
+      });
+    },
+  }, { assertOwnedRenderer() { counts.guard++; }, step() { counts.step++; } });
+  await ui.observeInput();
+  assert.deepEqual(sends, [{ method: 'Emulation.setFocusEmulationEnabled', params: { enabled: true } }]);
+  assert.equal(expressions.length, 2); assert.equal(expressions[1], 'document.visibilityState');
+  assert.deepEqual(registrations, ['pointerdown', 'pointerup', 'pointercancel', 'pointermove',
+    'click', 'keydown', 'keyup', 'focusin', 'focusout'].map(type => ({ type, options: { capture: true, passive: true } })));
+  const rows = () => {
+    const value = window.__TEST_desktopInputEvents;
+    assert.ok(Array.isArray(value)); return value as Record<string, unknown>[];
+  };
+  const emit = (type: string) => {
+    const listener = listeners.get(type); assert.ok(listener);
+    listener({ type, target: child, clientX: 191, clientY: 228, button: 0, buttons: 1,
+      isTrusted: true, defaultPrevented: false });
+    return rows().at(-1)!;
+  };
+  const microtask = () => { assert.equal(microtasks.length, 1); microtasks.shift()!(); assert.equal(timeouts.length, 1); };
+  const dispatch = () => { assert.equal(timeouts.length, 1); timeouts.shift()!(); };
+  const copy = (row: Record<string, unknown>) => row.teamNavigation === undefined
+    ? undefined : JSON.parse(JSON.stringify(row.teamNavigation)) as Record<string, unknown>;
+  return { a, b, state, store, window, getState, counts, fault, input, refusal, rows, emit,
+    microtask, dispatch, copy, expressions, sends, microtasks, timeouts };
+}
+
+test('passive original Team events retain the actual target and A-to-B-to-A observations in existing windows', async () => {
+  const f = await passiveTeamNavigationFixture();
+  for (const type of ['pointerdown', 'pointerup', 'click']) {
+    f.input.teamKey = f.b; f.state.selectedTeamName = f.a;
+    const row = f.emit(type);
+    assert.equal(row.type, type); assert.equal(row.trusted, true); assert.equal(row.taskClarification, null);
+    assert.equal(f.microtasks.length, 1); assert.equal(f.timeouts.length, 0);
+    assert.deepEqual(f.copy(row), { targetTeam: f.b, selectedBefore: f.a,
+      selectedAfterMicrotask: 'unknown', selectedAfterDispatch: 'unknown' });
+    f.input.teamKey = f.a; f.state.selectedTeamName = f.b; f.microtask();
+    assert.deepEqual(f.copy(row), { targetTeam: f.b, selectedBefore: f.a,
+      selectedAfterMicrotask: f.b, selectedAfterDispatch: 'unknown' });
+    f.state.selectedTeamName = f.a; f.dispatch();
+    assert.deepEqual(f.copy(row), { targetTeam: f.b, selectedBefore: f.a,
+      selectedAfterMicrotask: f.b, selectedAfterDispatch: f.a },
+    'the captured target is not reread after layout changes; these phases do not assert navigation settlement');
+    assert.equal(row.defaultPreventedAfterMicrotask, false); assert.equal(row.defaultPreventedAfterDispatch, false);
+  }
+  assert.deepEqual(f.counts, { state: 9, clock: 3, guard: 0, step: 0, target: 3, attribute: 3 });
+  const other = f.emit('keydown'); f.microtask(); f.dispatch();
+  assert.equal('teamNavigation' in other, false); assert.equal(f.counts.state, 9); assert.equal(f.counts.target, 3);
+  assert.equal(f.counts.clock, 4); assert.equal(f.expressions.length, 2); assert.equal(f.sends.length, 1);
+});
