+test('passive Team metadata remains bounded and independently unknown on unreadable or unqualified input', async () => {
+  const f = await passiveTeamNavigationFixture();
+  const sample = () => { const row = f.emit('click'); f.microtask(); f.dispatch(); return f.copy(row); };
+  f.input.hasCard = false; f.state.selectedTeamName = null;
+  assert.deepEqual(sample(), { targetTeam: 'none', selectedBefore: 'none',
+    selectedAfterMicrotask: 'none', selectedAfterDispatch: 'none' });
+  f.input.hasCard = true;
+  for (const value of [undefined, null, 17, {}, Object(f.b), 'TEST-private text', 'host-team:foreign',
+    'host-team:TEST-private\u0000suffix', 'host-team:TEST-space suffix', 'host-team:TEST-%2Fprivate',
+    'host-team:TEST-private\n', 'host-team:TEST-private\r', 'host-team:TEST-private\u2028',
+    'host-team:TEST-' + 'A'.repeat(178)]) {
+    f.input.teamKey = value; f.state.selectedTeamName = value;
+    const actual = sample();
+    assert.deepEqual(actual, { targetTeam: 'unknown', selectedBefore: value === null ? 'none' : 'unknown',
+      selectedAfterMicrotask: value === null ? 'none' : 'unknown', selectedAfterDispatch: value === null ? 'none' : 'unknown' });
+    assert.equal(JSON.stringify(actual).includes('private'), false);
+  }
+  const maximum = 'host-team:TEST-' + 'A'.repeat(177);
+  f.input.teamKey = maximum; f.state.selectedTeamName = maximum;
+  assert.equal(maximum.length, 192); assert.equal(Buffer.byteLength(JSON.stringify(sample())), 860);
+  f.input.teamKey = f.b; f.state.selectedTeamName = f.a;
+  for (const field of ['target', 'attribute'] as const) {
+    f.fault[field] = true;
+    assert.deepEqual(sample(), { targetTeam: 'unknown', selectedBefore: f.a,
+      selectedAfterMicrotask: f.a, selectedAfterDispatch: f.a });
+    f.fault[field] = false;
+  }
+  f.fault.state = true;
+  assert.deepEqual(sample(), { targetTeam: f.b, selectedBefore: 'unknown',
+    selectedAfterMicrotask: 'unknown', selectedAfterDispatch: 'unknown' });
+  f.fault.state = false;
+  f.store.getState = () => new Proxy({}, { getOwnPropertyDescriptor() { throw f.refusal; } });
+  assert.deepEqual(sample(), { targetTeam: f.b, selectedBefore: 'unknown',
+    selectedAfterMicrotask: 'unknown', selectedAfterDispatch: 'unknown' });
+  f.store.getState = f.getState;
+  let getterCalls = 0;
+  for (const [object, key, value] of [[f.window, '__agentTeamsDevStore', f.store],
+    [f.store, 'getState', f.getState], [f.state, 'selectedTeamName', f.a]] as const) {
+    Object.defineProperty(object, key, { configurable: true, get() { getterCalls++; return assert.fail('passive getter must not execute'); } });
+    assert.deepEqual(sample(), { targetTeam: f.b, selectedBefore: 'unknown',
+      selectedAfterMicrotask: 'unknown', selectedAfterDispatch: 'unknown' });
+    Object.defineProperty(object, key, { configurable: true, writable: true, value });
+  }
+  assert.equal(getterCalls, 0);
+  const row = f.emit('click'), retained = row.teamNavigation as Record<string, unknown>;
+  assert.deepEqual(f.copy(row), { targetTeam: f.b, selectedBefore: f.a,
+    selectedAfterMicrotask: 'unknown', selectedAfterDispatch: 'unknown' });
+  row.teamNavigation = new Proxy(retained, { set() { throw f.refusal; } });
+  assert.doesNotThrow(() => f.microtask()); assert.doesNotThrow(() => f.dispatch());
+  assert.equal(row.defaultPreventedAfterMicrotask, false); assert.equal(row.defaultPreventedAfterDispatch, false);
+  assert.equal(row.focusAfterMicrotask, null); assert.equal(row.focusAfterDispatch, null);
+  assert.deepEqual(f.copy(row), { targetTeam: f.b, selectedBefore: f.a,
+    selectedAfterMicrotask: 'unknown', selectedAfterDispatch: 'unknown' });
+  assert.equal(f.expressions.length, 2); assert.equal(f.sends.length, 1);
+  assert.equal(f.counts.guard, 0); assert.equal(f.counts.step, 0);
+});
