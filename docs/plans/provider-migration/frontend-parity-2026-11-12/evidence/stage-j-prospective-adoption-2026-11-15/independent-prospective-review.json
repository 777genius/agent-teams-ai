        "import assert from 'node:assert/strict';\nimport fs from 'node:fs';\nimport YAML from './node_modules/yaml/dist/index.js';\nconst paths = process.argv.slice(1);\nassert.deepEqual(paths, ['.github/workflows/host-emulated-acceptance.yml', '.github/workflows/electron-packaged-ci.yml']);\nfor (const path of paths) {\n  const info = fs.lstatSync(path);\n  assert.ok(info.isFile() && !info.isSymbolicLink() && info.size > 0 && info.size <= 131072, path);\n  const descriptor = fs.openSync(path, 'r');\n  let bytes;\n  try {\n    const buffer = Buffer.alloc(131072);\n    const length = fs.readSync(descriptor, buffer, 0, buffer.byteLength, 0);\n    assert.equal(length, info.size, path);\n    bytes = buffer.subarray(0, length);\n  } finally {\n    fs.closeSync(descriptor);\n  }\n  const source = bytes.toString('utf8');\n  assert.equal(Buffer.byteLength(source), bytes.byteLength, path);\n  const documents = YAML.parseAllDocuments(source, { version: '1.2', strict: true, uniqueKeys: true, prettyErrors: false });\n  assert.equal(documents.length, 1, path);\n  const document = documents[0];\n  assert.equal(document.errors.length, 0, path);\n  const value = document.toJS({ maxAliasCount: 100 });\n  assert.ok(value !== null && typeof value === 'object' && !Array.isArray(value), path);\n  console.log(JSON.stringify({ path, bytes: info.size, documents: 1, errors: 0, warnings: document.warnings.length }));\n}\n",
