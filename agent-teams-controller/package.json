{
  "name": "agent-teams-controller",
  "version": "1.0.0",
  "private": true,
  "description": "Controller package for Claude agent teams operations",
  "type": "commonjs",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./task-semantics": {
      "types": "./src/task-semantics.d.ts",
      "require": "./src/task-semantics.js",
      "default": "./src/task-semantics.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js"
  },
  "engines": {
    "node": ">=24.15.0 <25 || >=26 <27"
  }
}
