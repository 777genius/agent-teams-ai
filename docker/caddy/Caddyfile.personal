{
	servers {
		strict_sni_host on
	}
}

{$HOSTED_DOMAIN:agent-teams.localhost}:{$HOSTED_HTTPS_PORT:443} {
	tls internal
	@hosted_api path /api/hosted/v1/*
	@hosted_non_api {
		not path /api/hosted/v1/*
	}
	encode @hosted_non_api zstd gzip
	header @hosted_api Cache-Control "no-store, no-transform"
	reverse_proxy agent-teams-personal:3456 {
		header_up Accept-Encoding identity
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
	}
}
