{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node", "vitest/globals"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "../../scripts/ci/release/**/*.ts",
    "../../scripts/build/**/*.ts",
    "../../test/scripts/sentryArtifactInventory*.ts",
    "../../scripts/ci/*existing-draft.ts",
    "../../scripts/ci/verify-updater-release.ts",
    "../../scripts/ci/publish-carried-release.ts",
    "../../scripts/ci/publish-full-release.ts",
    "../../test/scripts/partialReleaseStaging.test.ts",
    "../../test/scripts/nativeReadiness.test.ts",
    "../../test/scripts/recoverDraftPayloads.test.ts",
    "../../scripts/electron-builder/**/*.mts",
    "../../scripts/lib/runtime-archive-extraction.mts",
    "../../scripts/lib/runtime-archive-extraction.test.mts",
    "../../scripts/lib/runtime-zip.test-fixture.mts",
    "../../scripts/lib/runtime-bootstrap-diagnostics.mts",
    "../../scripts/lib/runtime-command-capture.mts",
    "../../scripts/lib/runtime-payload-cache-async.test.mts",
    "../../scripts/lib/runtime-payload-inventory.mts",
    "../../scripts/lib/runtime-windows-zip-extraction.mts",
    "../../scripts/lib/runtime-windows-zip-extraction.test.mts",
    "../../scripts/stage-uap-runtime.ts",
    "../../scripts/electron-builder/beforePackUap.ts"
  ]
}
