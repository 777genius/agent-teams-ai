root = Stack([bars, lines, pies, tableAndText]);
bars = Card([CardHeader("Bar charts", "Static Plan and Actual data"), BarChart(["Jan", "Feb", "Mar"], [Series("Plan", [10, 20, 30]), Series("Actual", [12, 18, 33])], "grouped", "Month", "Count", 240), BarChart(["Jan", "Feb", "Mar"], [Series("Plan", [10, 20, 30]), Series("Actual", [12, 18, 33])], "stacked", null, null, 240)]);
lines = Card([CardHeader("Line charts"), LineChart(["Mon", "Tue", "Wed", "Thu"], [Series("Activity", [2, 7, 3, 9])], "linear"), LineChart(["Mon", "Tue", "Wed", "Thu"], [Series("Activity", [2, 7, 3, 9])], "natural"), LineChart(["Mon", "Tue", "Wed", "Thu"], [Series("Activity", [2, 7, 3, 9])], "step", null, null, 240)]);
pies = Card([CardHeader("Pie charts"), PieChart(["Rent", "Food", "Travel"], [60, 25, 15], "pie", "circular"), PieChart(["Rent", "Food", "Travel"], [60, 25, 15], "pie", "semiCircular"), PieChart(["Rent", "Food", "Travel"], [60, 25, 15], "donut", "circular"), PieChart(["Rent", "Food", "Travel"], [60, 25, 15], "donut", "semiCircular")]);
tableAndText = Card([CardHeader("Таблица и текст", "Unicode survives transport"), Table([Col("Category", ["Alpha", "Beta"], "string"), Col("Value", [10, 20], "number"), Col("Active", [true, false]), Col("Optional", [null, "Available"])]), TextContent("Small", "small"), TextContent("Default", "default"), TextContent("Large", "large"), TextContent("Small bold", "small-heavy"), TextContent("Large bold", "large-heavy")]);
