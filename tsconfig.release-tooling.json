{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node", "vitest/globals"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "scripts/ci/release/**/*.ts",
    "scripts/build/**/*.ts",
    "test/scripts/sentryArtifactInventory*.ts",
    "scripts/ci/*existing-draft.ts",
    "scripts/ci/verify-updater-release.ts",
    "scripts/ci/publish-carried-release.ts",
    "test/scripts/partialReleaseStaging.test.ts",
    "test/scripts/nativeReadiness.test.ts",
    "test/scripts/recoverDraftPayloads.test.ts",
    "scripts/electron-builder/**/*.mts"
  ]
}
