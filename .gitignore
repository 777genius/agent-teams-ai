# Provider-migration raw captures stay local; keep compact review handoffs/manifests.
/docs/plans/provider-migration/evidence/*/*
!/docs/plans/provider-migration/evidence/*/manifest.json
!/docs/plans/provider-migration/evidence/*/README.md
!/docs/plans/provider-migration/evidence/*/FINAL.md
/docs/plans/provider-migration/evidence/*.tar.gz
/docs/plans/provider-migration/evidence/*.tgz

# Reproducible local progress measurement scratch; reports and their data remain reviewable.
/docs/plans/provider-migration/progress/measure-progress.py
/docs/plans/provider-migration/progress/render-label-revision.py
/docs/plans/provider-migration/progress/loc-measurement.json

# Keep historical local package captures out of new diffs; retain the selected lockfile input.
/vendor/provider-migration/*/*.tgz
!/vendor/provider-migration/finite-claude-custody-v1/agent-teams-provider-session-contracts-0.0.0.tgz
!/vendor/provider-migration/typed-quality-validation-v2/agent-teams-provider-implementations-0.0.0.tgz

